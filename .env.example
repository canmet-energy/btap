# Setup:
#   cp .env.example .env
#   chmod 600 .env          # keeps the key readable only by you
#   $EDITOR .env            # fill in the value below
#   open a new terminal     # ~/.bashrc auto-loads .env for this workspace
#                           # if the key is still unset afterwards, your container
#                           # predates the auto-load — rebuild it once, or run
#                           # `bash .devcontainer/setup.sh` to append the block
#
# To load it by hand in an existing shell:
#   set -a && source .env && set +a
# The `set -a` matters: a plain `source .env` sets shell variables without
# exporting them, so child processes (Claude Code's ${HBIX_API_KEY} expansion
# in .mcp.json) would not see the key.
#
# Same variable name as canmet-energy/bluesky, deliberately: one key, one name,
# so a .env copied between the two repos works in both.

# hbix API key. ONE key, ONE name — it covers all six NRCan MCP servers in
# .mcp.json and both Python maintainer clients:
#   python/scripts/fetch_necb_8_4_text.py
#   python/scripts/building_stock.py
HBIX_API_KEY=your_key

# Optional, and the ONLY other knob: repoints all six servers at once, for the
# Python scripts and .mcp.json alike. Unset uses production. There are no
# per-server overrides — one key, one base URL.
HBIX_MCP_BASE_URL=https://3ucoopudrb.execute-api.ca-central-1.amazonaws.com/prod
