# MCP server configuration — holds live API keys. NEVER commit.
# The two Python clients that read it (python/scripts/building_stock.py and
# python/scripts/fetch_necb_8_4_text.py) fall back to environment
# variables, so an absent .mcp.json is a supported configuration.
.mcp.json

# The API key itself. .env is where HBIX_API_KEY lives (same name and mechanism
# as canmet-energy/bluesky); .env.example is the tracked template. ~/.bashrc
# auto-loads .env — see .devcontainer/setup.sh.
.env
!.env.example

# Claude Code's per-developer settings. Untracked by intent: it names enabled
# MCP servers and permission grants, and is exactly the file a stray `git add .`
# would otherwise sweep in.
.claude/settings.local.json

# Developer installation. legacy_pin/.bundle/config is committed because it
# points the surviving oracle bundle at the shared vendor/ directory.
/.bundle/
/vendor
/.venv

# The only Bundler lock is deliberate: it pins the parity oracle's
# openstudio-standards source and tbd/osut/topolys triplet.
Gemfile.lock
!legacy_pin/Gemfile.lock

# Build output
/pkg/

# IDE files
/.idea
/netbeans
/.vscode
/.VSCodeCounter
/.serena

# Test + run output
output/
coverage/
!python/btap/necb/data/coverage/
!python/btap/necb/data/coverage/**
/tmp/
run/
*.osw
*.sql
*.err
*.eio
*.rdd
*.mdd
*.audit
eplusout.*
eplustbl.*

# Generated reports (regenerate rather than commit)
compliance_report*.html
audit.json
audit.txt
report.json

# CLI run output: btap-compliance defaults -o to ./necb_run_<model> in the
# CURRENT directory, so runs launched from the repo root land here. The
# individual-file patterns above happen to cover today's contents; this
# ignores the DIRECTORY so any future artifact inside it stays invisible too.
necb_run_*/

# Python product + verification interpreter droppings
__pycache__/
*.pyc
python/.venv/
python/.ci-venv/
python/*.egg-info/
python/build/
python/dist/

*.DS_Store

# Corporate CAs copied off the HOST's trust store by devcontainer.json's
# initializeCommand. Machine-local and site-specific — staged for the build,
# never committed.
/.devcontainer/certs/

# Windows packaging output assembled from the Python distribution and bundled
# runtimes. These are derived artifacts, not source.
/packaging/windows/stage/
/packaging/windows/Output/
/packaging/windows/samples/
python/tests/generated/
python/.parity-venv/

# D-80 R4: the frozen scenario baselines COMMIT the very filenames ignored
# above (audit.json/audit.txt/report.json are unanchored patterns, so
# without these negations a freeze would be silently untracked — the
# tracked-after-freeze negative control guards this).
!verification/scenarios/baselines/**/audit.json
!verification/scenarios/baselines/**/audit.txt
!verification/scenarios/baselines/**/report.json
packaging/pypi/energyplus/dist/
