# MCP server configuration — holds live API keys. NEVER commit.
# The two scripts that read it (btap-modeling/scripts/building_stock.rb,
# btap-necb/scripts/fetch_necb_8_4_text.rb) fall back to environment
# variables, so an absent .mcp.json is a supported configuration.
.mcp.json

# The API key itself. .env is where HBIX_API_KEY lives (same name and mechanism
# as canmet-energy/bluesky); .env.example is the tracked template. ~/.bashrc
# auto-loads .env — see .devcontainer/setup.sh.
.env
!.env.example

# Claude Code's per-developer settings. Untracked by intent: it names enabled
# MCP servers and permission grants, and is exactly the file a stray `git add .`
# would otherwise sweep in.
.claude/settings.local.json

# Developer installation. Scoped deliberately: legacy_pin/.bundle/config IS
# committed (it points the oracle's bundle at the shared vendor/ dir), and git
# cannot re-include a file whose parent directory is excluded.
/.bundle/
btap-*/.bundle/
/vendor
/.venv

# Gems do not commit their lockfile — resolution is the consumer's business.
# legacy_pin is the deliberate exception: its lock pins the parity oracle's
# tbd/osut/topolys triplet, and a floating osut changes generated insulation
# materials (see legacy_pin/README.md).
Gemfile.lock
!legacy_pin/Gemfile.lock

# Build output
/pkg/
*.gem

# IDE files
/.idea
/netbeans
/.vscode
/.VSCodeCounter
/.serena

# Rubocop / YARD output
/.rubocop
/.rubocop-http*
/.yardoc
/doc/

# Test + run output
output/
coverage/
/tmp/
run/
*.osw
*.sql
*.err
*.eio
*.rdd
*.mdd
*.audit
eplusout.*
eplustbl.*

# Generated reports (regenerate rather than commit)
compliance_report*.html
audit.json
audit.txt
report.json

# CLI run output: btap-compliance defaults -o to ./necb_run_<model> in the
# CURRENT directory, so runs launched from the repo root land here. The
# individual-file patterns above happen to cover today's contents; this
# ignores the DIRECTORY so any future artifact inside it stays invisible too.
necb_run_*/

# The Python port (python/) + the verification harness's interpreter droppings
__pycache__/
*.pyc
python/.venv/
python/.ci-venv/
python/*.egg-info/
python/build/
python/dist/

*.DS_Store

# Corporate CAs copied off the HOST's trust store by devcontainer.json's
# initializeCommand. Machine-local and site-specific — staged for the build,
# never committed.
/.devcontainer/certs/

# Windows packaging build output. `rake windows:stage` assembles a COPY of the
# five gems' lib/ trees (plus, when OPENSTUDIO_WINDOWS is set, a ~1.1 GB
# OpenStudio) — all of it derived, none of it source.
/packaging/windows/stage/
/packaging/windows/Output/
/packaging/windows/samples/
python/tests/generated/
python/.parity-venv/
