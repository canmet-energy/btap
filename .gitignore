# MCP server configuration — holds live API keys. NEVER commit.
# The two scripts that read it (openstudio-geometry/scripts/building_stock.rb,
# openstudio-necb/scripts/fetch_necb_8_4_text.rb) fall back to environment
# variables, so an absent .mcp.json is a supported configuration.
.mcp.json

# Developer installation. Scoped deliberately: legacy_pin/.bundle/config IS
# committed (it points the oracle's bundle at the shared vendor/ dir), and git
# cannot re-include a file whose parent directory is excluded.
/.bundle/
openstudio-*/.bundle/
/vendor
/.venv

# Gems do not commit their lockfile — resolution is the consumer's business.
# legacy_pin is the deliberate exception: its lock pins the parity oracle's
# tbd/osut/topolys triplet, and a floating osut changes generated insulation
# materials (see legacy_pin/README.md).
Gemfile.lock
!legacy_pin/Gemfile.lock

# Build output
/pkg/
*.gem

# IDE files
/.idea
/netbeans
/.vscode
/.VSCodeCounter
/.serena

# Rubocop / YARD output
/.rubocop
/.rubocop-http*
/.yardoc
/doc/

# Test + run output
output/
coverage/
/tmp/
run/
*.osw
*.sql
*.err
*.eio
*.rdd
*.mdd
*.audit
eplusout.*
eplustbl.*

# Generated reports (regenerate rather than commit)
compliance_report*.html
audit.json
audit.txt
report.json

*.DS_Store
